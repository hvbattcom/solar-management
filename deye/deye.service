[Unit]
Description=Deye Inverter Management API
After=network.target

[Service]
Type=simple
User=solar
WorkingDirectory=/media/grafanas-vm/solar_planner/solar-management/deye
ExecStart=/usr/bin/python3 /media/grafanas-vm/solar_planner/solar-management/deye/deye-api.py --host 0.0.0.0 --port 5000
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=deye

[Install]
WantedBy=multi-user.target
