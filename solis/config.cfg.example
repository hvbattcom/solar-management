[SolisInverter]
# Solis Inverter Configuration File

# IP address of the logger device
inverter_ip = <logger_ip>

# Optional; 502 is common for newer S2-WL-ST, 8899 for some older loggers
inverter_port = 502

# Modbus device id / unit id
slave_id = 1

# Expected inverter serial – if mismatch, the serial registers are re-read once;
# if it still mismatches, output is suppressed and an error is returned (/metrics
# answers 502, so the scrape fails instead of publishing data under a wrong serial).
# STRONGLY RECOMMENDED: `serial` is a label on every exported metric, so a single
# corrupted Modbus read forks the whole metric set onto a new Prometheus series.
# Leave empty only if the serial is unknown – the monitor then pins the first
# serial that two consecutive reads agree on and checks every later poll against it.
serial = <logger_serial>

# Inverter rated power in kW – used to calculate load percentages
inverter_power_kw = 30

# Number of physical MPPT inputs (1-4) – limits PV string reporting; unused strings are suppressed
mppt_count = 3

# default_sanity_ranges.cfg is loaded first; any key set here overrides it
# Example: uncomment to accept all-zero grid readings when grid is physically off
# zeros_ok_grid = true

# TEMPORARY legacy-compat: when true, the /metrics (prometheus) output also emits
# the 8 legacy-named metric aliases the new exporter renamed/dropped, so old
# dashboards keep working during migration. Default off. Remove after migration.
# legacy_metrics = true

# Whether this plant sells energy back to the grid -- purely informational,
# exposed as plant_feature_enabled{feature="selling"} for dashboards to key
# panel visibility off of (e.g. hide price panels on self-consumption-only
# sites). Has no effect on inverter communication.
selling_enabled = false

[SolisAPI]
# Bind address and port for solis-api.py (also used by dispatch.py to reach it)
host = 0.0.0.0
port = 5000
