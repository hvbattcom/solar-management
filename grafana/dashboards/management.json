        },
        "content": "<!-- Solar Inverter Management Panel — shared template for Deye and Solis -->\n<style>\n  :root { --accent: #94a3b8; --accent2: #64748b; }\n\n  .inv {\n    --bg:     #f0f4f8;\n    --card:   #ffffff;\n    --border: #dde2e8;\n    --ok:     #16a34a;\n    --err:    #dc2626;\n    --text:   #1e293b;\n    --muted:  #64748b;\n    --r:      8px;\n    font: 15px/1.6 system-ui, sans-serif;\n    color: #1e293b;\n    background: #f0f4f8;\n    color-scheme: light;\n  }\n  .inv *, .inv *::before, .inv *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n  /* ── Header ── */\n  .inv-header {\n    background: var(--accent); color: #fff;\n    padding: 14px 24px; display: flex; align-items: center; gap: 12px;\n  }\n  .inv-header h1 { font-size: 1.2rem; flex: 1; }\n  .inv-header #updated { font-size: 0.82rem; opacity: .85; }\n  .inv-header button {\n    padding: 6px 14px; background: rgba(255,255,255,.2); color: #fff;\n    border: 1px solid rgba(255,255,255,.4); border-radius: 6px;\n    font-size: 0.85rem; cursor: pointer;\n  }\n  .inv-header button:hover { background: rgba(255,255,255,.35); }\n\n  /* ── Layout ── */\n  .inv-main { max-width: 980px; margin: 24px auto; padding: 0 16px; display: flex; flex-direction: column; gap: 20px; }\n\n  /* ── Card ── */\n  .inv .card { background: var(--card); border: 1px solid var(--border); border-radius: var(--r); padding: 20px; }\n  .inv .card h2 {\n    font-size: .78rem; font-weight: 700; text-transform: uppercase;\n    letter-spacing: .07em; color: var(--muted); margin-bottom: 16px;\n  }\n\n  /* ── Fields ── */\n  .inv .field { display: flex; flex-direction: column; gap: 4px; }\n  .inv .field label { font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }\n  .inv .field input[type=number] {\n    padding: 8px 10px; border: 1px solid #dde2e8 !important; border-radius: 6px;\n    font-size: .95rem; color: #1e293b !important; -webkit-text-fill-color: #1e293b !important;\n    background: #fff !important; width: 100%;\n  }\n  .inv .field input:focus { outline: 2px solid var(--accent); border-color: transparent !important; }\n  .inv .field input[type=number]:disabled {\n    opacity: .45; cursor: not-allowed;\n    background: #f1f5f9 !important; -webkit-text-fill-color: #94a3b8 !important;\n  }\n\n  /* ── Custom select (avoids Grafana CSS override of native <select>) ── */\n  .inv-sel { position: relative; width: 100%; cursor: pointer; user-select: none; }\n  .inv-sel-val {\n    padding: 8px 32px 8px 10px; border: 1px solid #dde2e8; border-radius: 6px;\n    font-size: .95rem; color: #1e293b; background: #fff !important;\n    display: flex; align-items: center; min-height: 38px;\n  }\n  .inv-sel-val::after { content: '▾'; position: absolute; right: 10px; top: 50%; transform: translateY(-50%); color: #64748b; pointer-events: none; }\n  .inv-sel.open .inv-sel-val { border-color: var(--accent); outline: 2px solid var(--accent); border-radius: 6px 6px 0 0; }\n  .inv-sel-opts {\n    display: none; position: absolute; top: 100%; left: 0; right: 0; z-index: 200;\n    background: #fff; border: 1px solid var(--accent); border-top: none;\n    border-radius: 0 0 6px 6px; box-shadow: 0 6px 16px rgba(0,0,0,.12);\n  }\n  .inv-sel.open .inv-sel-opts { display: block; }\n  .inv-sel-opt { padding: 9px 10px; font-size: .95rem; color: #1e293b; cursor: pointer; }\n  .inv-sel-opt:hover { background: #f0f4f8; }\n  .inv-sel-opt.sel { color: var(--accent); font-weight: 600; }\n  /* Two-line options: a plain-language name over what it actually does. */\n  .inv-sel-opt .opt-name { display: block; }\n  .inv-sel-opt .opt-desc { display: block; font-size: .78rem; color: #64748b;\n                           font-weight: 400; margin-top: 1px; line-height: 1.3; }\n  .inv-sel-opt.sel .opt-desc { color: #7c8ba1; }\n  .sel-hint { font-size: .78rem; color: #64748b; line-height: 1.35; margin-top: 5px; }\n  .lbl-note { font-weight: 400; color: #94a3b8; font-size: .8rem; }\n\n  /* ── Toggle ── */\n  .inv .tog { display: flex; align-items: center; gap: 8px; cursor: pointer; }\n  .inv .tog input { width: 17px; height: 17px; accent-color: var(--accent); cursor: pointer; }\n  .inv .tog span { font-size: .9rem; }\n\n  /* ── Actions ── */\n  .inv .actions { display: flex; align-items: center; gap: 12px; margin-top: 16px; }\n  .inv button.primary {\n    padding: 8px 20px; background: var(--accent); color: #fff;\n    border: none; border-radius: 6px; font-size: .9rem; font-weight: 600; cursor: pointer;\n  }\n  .inv button.primary:hover { background: var(--accent2); }\n  .inv button.primary:disabled { opacity: .5; cursor: default; }\n\n  /* ── Messages ── */\n  .inv .msg { font-size: .83rem; font-weight: 700; }\n  .inv .msg.ok  { color: var(--ok); }\n  .inv .msg.err { color: var(--err); }\n\n  /* ── Setting rows ── */\n  .inv .setting-rows { display: flex; flex-direction: column; gap: 10px; }\n  .inv .setting-row  { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }\n  .inv .setting-row .field { flex: 0 0 260px; }\n  .inv .setting-row .tog   { flex: 1; padding-top: 18px; }\n\n  /* ── Battery inputs ── */\n  .inv .bat-input {\n    flex: 1; padding: 7px 8px; border-radius: 6px; font-size: .92rem;\n    border: 1px solid #dde2e8 !important;\n    background: #fff !important;\n    color: #1e293b !important;\n    -webkit-text-fill-color: #1e293b !important;\n  }\n  .inv .bat-label { font-size: .75rem; font-weight: 700; letter-spacing: .06em; color: var(--muted); text-align: center; white-space: nowrap; }\n  .inv .bat-unit  { font-size: .8rem; color: var(--muted); flex-shrink: 0; }\n  .inv .bat-cell  { display: flex; align-items: center; gap: 5px; }\n\n  /* ── TOU table ── */\n  .inv .tou-wrap { overflow-x: auto; }\n  .inv table { width: 100%; border-collapse: collapse; font-size: .88rem; }\n  .inv th {\n    text-align: left; font-size: .72rem; text-transform: uppercase;\n    letter-spacing: .06em; color: var(--muted);\n    padding: 6px 8px; border-bottom: 2px solid var(--border); white-space: nowrap;\n  }\n  .inv td { padding: 5px 4px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; }\n  .inv tr:last-child td { border-bottom: none; }\n  .inv tr.on td { background: #f0fdf4; }\n  .inv td.num { font-weight: 700; color: var(--muted); text-align: center; width: 28px; }\n  .inv td input[type=checkbox] { display: block; margin: auto; width: 16px; height: 16px; accent-color: var(--accent); cursor: pointer; }\n  .inv td input[type=number] {\n    padding: 5px 6px; border: 1px solid #dde2e8 !important; border-radius: 5px;\n    font-size: .86rem; width: 100%; background: #fff !important;\n    color: #1e293b !important; -webkit-text-fill-color: #1e293b !important;\n  }\n  .inv td input:focus { outline: 2px solid var(--accent); border-color: transparent; }\n  .inv td input[type=number]:disabled { opacity: .45; cursor: not-allowed; background: #f1f5f9 !important; -webkit-text-fill-color: #94a3b8 !important; }\n  .inv button.time-btn:disabled { opacity: .45; cursor: not-allowed; border-color: var(--border); }\n  .inv .col-time { width: 80px; }\n  .inv .col-n    { width: 84px; }\n  .inv .col-cb   { width: 52px; text-align: center; }\n\n  /* ── Time button ── */\n  .inv button.time-btn {\n    width: 100%; padding: 5px 4px;\n    background: #fff; border: 1px solid var(--border); border-radius: 5px;\n    font-size: .9rem; font-family: ui-monospace, monospace;\n    cursor: pointer; text-align: center; color: var(--text);\n  }\n  .inv button.time-btn:hover { border-color: var(--accent); }\n\n  /* ── Auto-managed switch ── */\n  .auto-switch { display:flex; align-items:center; gap:8px; cursor:pointer; color:#fff; user-select:none; }\n  .auto-switch input { display:none; }\n  .sw-track {\n    width:38px; height:22px; border-radius:11px; flex-shrink:0;\n    background:rgba(255,255,255,0.25); border:1.5px solid rgba(255,255,255,0.45);\n    position:relative; transition:background .2s, border-color .2s;\n  }\n  .sw-thumb {\n    position:absolute; width:15px; height:15px; border-radius:50%;\n    background:#fff; top:2px; left:2px;\n    transition:transform .2s; box-shadow:0 1px 3px rgba(0,0,0,.3);\n  }\n  .auto-switch input:checked + .sw-track { background:rgba(255,255,255,0.92); border-color:rgba(255,255,255,0.92); }\n  .auto-switch input:checked + .sw-track .sw-thumb { transform:translateX(16px); background:var(--accent); }\n  #auto-banner {\n    display: none; background: #dbeafe; border: 1px solid #93c5fd;\n    border-radius: var(--r); padding: 10px 20px; margin: 12px 16px 0;\n    font-size: .85rem; color: #1d4ed8; font-weight: 600; text-align: center;\n  }\n  #auto-banner.visible { display: block; }\n  #main-wrap { position: relative; }\n  #auto-overlay {\n    display: none; position: absolute; inset: 0; z-index: 100;\n    background: rgba(240,244,248,0.35); border-radius: var(--r); cursor: not-allowed;\n  }\n\n  /* ── Drum picker modal ── */\n  .inv-tp-overlay {\n    position: fixed; inset: 0; background: rgba(0,0,0,.45);\n    display: flex; align-items: center; justify-content: center; z-index: 99999;\n  }\n  .inv-tp-dialog {\n    background: #fff; border-radius: 20px; width: 280px;\n    overflow: hidden; box-shadow: 0 24px 64px rgba(0,0,0,.3);\n    user-select: none; font-family: system-ui, sans-serif;\n  }\n  .inv-tp-dialog .tp-header { padding: 16px 16px 12px; text-align: center; font-weight: 700; font-size: 1rem; color: #1e293b; }\n  .inv-tp-dialog .tp-drums  { display: flex; align-items: center; justify-content: center; height: 220px; padding: 0 8px; }\n  .inv-tp-dialog .tp-col    { flex: 1; height: 100%; position: relative; overflow: hidden; cursor: grab; touch-action: none; }\n  .inv-tp-dialog .tp-col:active { cursor: grabbing; }\n  .inv-tp-dialog .tp-items  { position: absolute; width: 100%; will-change: transform; }\n  .inv-tp-dialog .tp-item   { height: 44px; display: flex; align-items: center; justify-content: center; font-size: 1.75rem; font-weight: 500; color: #1e293b; font-variant-numeric: tabular-nums; font-family: ui-monospace, monospace; }\n  .inv-tp-dialog .tp-hl     { position: absolute; top: 50%; transform: translateY(-50%); width: 100%; height: 44px; pointer-events: none; border-top: 2px solid var(--accent); border-bottom: 2px solid var(--accent); }\n  .inv-tp-dialog .tp-col::before, .inv-tp-dialog .tp-col::after { content: ''; position: absolute; left: 0; right: 0; height: 88px; z-index: 1; pointer-events: none; }\n  .inv-tp-dialog .tp-col::before { top: 0;    background: linear-gradient(to bottom, rgba(255,255,255,.97), transparent); }\n  .inv-tp-dialog .tp-col::after  { bottom: 0; background: linear-gradient(to top,    rgba(255,255,255,.97), transparent); }\n  .inv-tp-dialog .tp-sep    { font-size: 2.2rem; font-weight: 700; padding: 0 10px; color: #1e293b; flex-shrink: 0; margin-bottom: 4px; }\n  .inv-tp-dialog .tp-actions { display: flex; border-top: 1px solid #dde2e8; }\n  .inv-tp-dialog .tp-actions button { flex: 1; padding: 15px; border: none; background: none; font-size: .95rem; font-weight: 600; cursor: pointer; }\n  .inv-tp-dialog .tp-actions button:first-child { border-right: 1px solid #dde2e8; color: #64748b; }\n  .inv-tp-dialog .tp-actions button:last-child  { color: var(--accent); }\n  .inv-tp-dialog .tp-actions button:hover { background: #f0f4f8; }\n</style>\n\n<div class=\"inv\">\n  <div class=\"inv-header\">\n    <h1 id=\"brand-title\">Solar Management</h1>\n    <span id=\"updated\">—</span>\n    <label class=\"auto-switch\" id=\"auto-switch-wrap\" style=\"display:none\">\n      <input type=\"checkbox\" id=\"auto-managed\" onchange=\"setAutoManaged(this.checked)\">\n      <div class=\"sw-track\"><div class=\"sw-thumb\"></div></div>\n      <span style=\"font-size:.85rem\">Auto-managed</span>\n    </label>\n    <button onclick=\"loadSettings()\">↻ Refresh</button>\n  </div>\n  <div id=\"auto-banner\">⚙ Dispatcher active — manual edits disabled. Switch off Auto-managed to take over.</div>\n\n  <div id=\"main-wrap\">\n    <div id=\"auto-overlay\"></div>\n    <div class=\"inv-main\">\n\n      <!-- General + Battery side by side -->\n      <div style=\"display:flex;gap:20px;align-items:flex-start;flex-wrap:wrap\">\n\n        <!-- General / Storage Settings -->\n        <div class=\"card\" style=\"flex:3\">\n          <h2 id=\"general-card-title\">General</h2>\n          <div class=\"setting-rows\">\n            <!-- Row 1: Mode + Grid Charge -->\n            <div class=\"setting-row\">\n              <!-- Deye: limit control (reg 142) shown as \"Mode\" -->\n              <div class=\"field\" id=\"deye-mode-field\" style=\"display:none\">\n                <label>Mode <span class=\"lbl-note\">— what may leave the plant</span></label>\n                <div class=\"inv-sel\" id=\"zero_export\" data-value=\"Selling First\"\n                     data-hint=\"mode-hint\" onclick=\"selToggle(this)\">\n                  <div class=\"inv-sel-val\">Selling First</div>\n                  <div class=\"inv-sel-opts\">\n                    <div class=\"inv-sel-opt sel\" data-val=\"Selling First\"\n                         data-hint=\"Exports up to Sell Power. Draws from PV and, wherever a ToU slot's SOC target sits below the current level, from the battery too.\"\n                         onclick=\"selPick(this, event)\">\n                      <span class=\"opt-name\">Selling First</span>\n                      <span class=\"opt-desc\">Exports to grid — can also sell the battery</span>\n                    </div>\n                    <div class=\"inv-sel-opt\" data-val=\"Zero Export to Load\"\n                         data-hint=\"Nothing is exported, limited at the load side.\"\n                         onclick=\"selPick(this, event)\">\n                      <span class=\"opt-name\">Zero Export to Load</span>\n                      <span class=\"opt-desc\">No export — limited at the load</span>\n                    </div>\n                    <div class=\"inv-sel-opt\" data-val=\"Zero Export to CT\"\n                         data-hint=\"Nothing is exported, measured at the grid meter. The battery still serves the house.\"\n                         onclick=\"selPick(this, event)\">\n                      <span class=\"opt-name\">Zero Export to CT</span>\n                      <span class=\"opt-desc\">No export — measured at the grid meter</span>\n                    </div>\n                  </div>\n                </div>\n                <div class=\"sel-hint\" id=\"mode-hint\"></div>\n              </div>\n              <!-- Solis: energy_mode as \"Mode\" / Deye: hidden \"Energy Pattern\" -->\n              <div class=\"field\" id=\"solis-mode-field\" style=\"display:none\">\n                <label>Mode</label>\n                <div class=\"inv-sel\" id=\"mode\" data-value=\"\" onclick=\"selToggle(this)\">\n                  <div class=\"inv-sel-val\"></div>\n                  <div class=\"inv-sel-opts\"></div>\n                </div>\n              </div>\n              <label class=\"tog\">\n                <input type=\"checkbox\" id=\"grid_charge\">\n                <span id=\"grid-charge-label\">Grid Charge</span>\n              </label>\n            </div>\n            <!-- Row 2: Sell/Export Power + Sell/Export Enable -->\n            <div class=\"setting-row\">\n              <div class=\"field\">\n                <label id=\"sell-power-label\">Sell Power (W)</label>\n                <input type=\"number\" id=\"sell_power\" min=\"0\" step=\"10\">\n              </div>\n              <label class=\"tog\">\n                <input type=\"checkbox\" id=\"sell_enable\" onchange=\"setSellLock(this.checked)\">\n                <span id=\"sell-enable-label\">Solar Sell Enable</span>\n              </label>\n            </div>\n            <!-- Row 3: Peak Shaving Power + Peak Shaving -->\n            <div class=\"setting-row\">\n              <div class=\"field\">\n                <label>Grid Peak Shaving Power (W)</label>\n                <input type=\"number\" id=\"peak_shaving_power\" min=\"0\" step=\"10\">\n              </div>\n              <label class=\"tog\">\n                <input type=\"checkbox\" id=\"peak_shaving\" onchange=\"setPeakShavingLock(this.checked)\">\n                <span>Peak Shaving</span>\n              </label>\n            </div>\n            <!-- Row 4: Battery Reserve — Solis only -->\n            <div class=\"setting-row\" id=\"reserve-row\" style=\"display:none\">\n              <div class=\"field\">\n                <label>Battery Reserve (%)</label>\n                <input type=\"number\" id=\"battery_reserve_pct\" min=\"0\" max=\"100\" step=\"1\">\n              </div>\n              <label class=\"tog\">\n                <input type=\"checkbox\" id=\"battery_reserve_on\" onchange=\"setReserveLock(this.checked)\">\n                <span>Battery Reserve Switch</span>\n              </label>\n            </div>\n          </div>\n          <div class=\"actions\">\n            <button class=\"primary\" onclick=\"saveGeneral()\">Save</button>\n            <span class=\"msg\" id=\"general-msg\"></span>\n          </div>\n        </div>\n\n        <!-- Battery Settings -->\n        <div class=\"card\" style=\"flex:2\">\n          <h2>Battery</h2>\n          <div style=\"display:grid;grid-template-columns:auto 1fr 1fr;gap:8px 12px;align-items:center\">\n            <div></div>\n            <div class=\"bat-label\">BAT1</div>\n            <div class=\"bat-label\">BAT2</div>\n\n            <div class=\"bat-label\">Charge</div>\n            <div class=\"bat-cell\">\n              <input type=\"number\" id=\"bat1_charge\" min=\"1\" max=\"300\" step=\"1\" class=\"bat-input\">\n              <span class=\"bat-unit\">A</span>\n            </div>\n            <div class=\"bat-cell\">\n              <input type=\"number\" id=\"bat2_charge\" min=\"1\" max=\"300\" step=\"1\" class=\"bat-input\">\n              <span class=\"bat-unit\">A</span>\n            </div>\n\n            <div class=\"bat-label\">Discharge</div>\n            <div class=\"bat-cell\">\n              <input type=\"number\" id=\"bat1_discharge\" min=\"1\" max=\"300\" step=\"1\" class=\"bat-input\">\n              <span class=\"bat-unit\">A</span>\n            </div>\n            <div class=\"bat-cell\">\n              <input type=\"number\" id=\"bat2_discharge\" min=\"1\" max=\"300\" step=\"1\" class=\"bat-input\">\n              <span class=\"bat-unit\">A</span>\n            </div>\n          </div>\n          <div class=\"actions\">\n            <button class=\"primary\" onclick=\"saveBattery()\">Save</button>\n            <span class=\"msg\" id=\"battery-msg\"></span>\n          </div>\n        </div>\n\n      </div><!-- end side-by-side -->\n\n      <!-- Deye TOU (shown for Deye, hidden for Solis) -->\n      <div id=\"tou-deye\" class=\"card\" style=\"display:none\">\n        <h2>Time of Use — 6 Slots</h2>\n        <div class=\"tou-wrap\">\n          <table>\n            <thead>\n              <tr>\n                <th>#</th>\n                <th class=\"col-cb\">Grid ⚡</th>\n                <th class=\"col-cb\">Gen 🔧</th>\n                <th class=\"col-cb\">Sell →</th>\n                <th class=\"col-time\">Start</th>\n                <th class=\"col-time\">End</th>\n                <th class=\"col-n\">Power W</th>\n                <th class=\"col-n\" title=\"The level the inverter drives the battery TOWARD during this slot — not a floor it merely refuses to cross. Below the current SoC it will discharge, and with Mode set to Export allowed it exports the battery to the grid.\">SOC&nbsp;% target</th>\n              </tr>\n            </thead>\n            <tbody id=\"tou-body\"></tbody>\n          </table>\n        </div>\n        <div class=\"actions\">\n          <button class=\"primary\" onclick=\"saveTou()\">Save All</button>\n          <span class=\"msg\" id=\"tou-msg\"></span>\n        </div>\n      </div>\n\n\n    </div><!-- inv-main -->\n  </div><!-- main-wrap -->\n</div><!-- inv -->\n\n<!-- Drum time picker modal (outside .inv so position:fixed covers full screen) -->\n<div id=\"tp-modal\" class=\"inv-tp-overlay\" style=\"display:none\" onclick=\"if(event.target===this)cancelTimePicker()\">\n  <div class=\"inv-tp-dialog\">\n    <div class=\"tp-header\">Set Time</div>\n    <div class=\"tp-drums\">\n      <div class=\"tp-col\" id=\"tp-hour\"></div>\n      <div class=\"tp-sep\">:</div>\n      <div class=\"tp-col\" id=\"tp-min\"></div>\n    </div>\n    <div class=\"tp-actions\">\n      <button onclick=\"cancelTimePicker()\">Cancel</button>\n      <button onclick=\"confirmTimePicker()\">OK</button>\n    </div>\n  </div>\n</div>\n\n<script>\nconst BASE = \"/api/datasources/proxy/uid/__PLANT_API_DATASOURCE_UID__\";\n\n/* ── Brand config ─────────────────────────────────────────────────────────────\n   gf: general API field names  (read from API response, write to API body)\n   bf: battery API field names  (same pattern)\n   powerStep: W rounding for sell/peak power (Solis requires multiples of 100)\n*/\nconst BRAND_CFG = {\n  deye: {\n    title:          '⚡ Deye Management',\n    accent:         '#0ea5e9',\n    accent2:        '#0284c7',\n    energyPatternOptions: ['Self Use', 'Selling First', 'Battery First', 'Load First'],\n    generalTitle:   'General',\n    sellPowerLabel: 'Max Sell Power (W)',\n    sellLabel:      'Solar Sell Enable',\n    gridChargeLabel:'Grid Charge Enable',\n    generalEndpoint:'/api/settings/general',\n    powerStep:      10,\n    gf: {\n      mode:          'energy_mode',\n      limit_control: 'limit_control',\n      grid_charge:   'grid_charge_enable',\n      sell_enable:   'solar_sell_enable',\n      sell_power:    'max_sell_power_w',\n      peak_shaving:  'grid_peak_shaving_on',\n      peak_power:    'grid_peak_shaving_power_w',\n    },\n    bf: {\n      bat1_charge:    'max_charge_a',\n      bat2_charge:    'bat2_max_charge_a',\n      bat1_discharge: 'max_discharge_a',\n      bat2_discharge: 'bat2_max_discharge_a',\n    },\n  },\n  solis: {\n    title:          '☀️ Solis Management',\n    accent:         '#f97316',\n    accent2:        '#ea6c0a',\n    modeOptions:    ['Self Use', 'Selling First', 'Off Grid'],\n    generalTitle:   'Storage Settings',\n    sellPowerLabel: 'Max Export Power (W)',\n    sellLabel:      'Allow Export',\n    gridChargeLabel:'Allow Grid Charge',\n    generalEndpoint:'/api/settings/storage',\n    powerStep:      100,\n    gf: {\n      mode:         'mode',\n      grid_charge:  'allow_grid_charge',\n      sell_enable:  'allow_export',\n      sell_power:   'max_export_power_w',\n      peak_shaving: 'peak_shaving_on',\n      peak_power:   'peak_shaving_power_w',\n      reserve:      'battery_reserve_on',\n      reserve_pct:  'battery_reserve_pct',\n    },\n    bf: {\n      bat1_charge:    'bat1_charge_current_a',\n      bat2_charge:    'bat2_charge_current_a',\n      bat1_discharge: 'bat1_discharge_current_a',\n      bat2_discharge: 'bat2_discharge_current_a',\n    },\n  },\n};\n\nlet _brand = null;\nlet _cfg   = null;\n\n/* ── Brand init ───────────────────────────────────────────────────────────── */\nfunction applyBrand(info) {\n  _brand = info.brand;\n  _cfg   = BRAND_CFG[_brand];\n\n  // CSS variables on :root so the picker modal (outside .inv) also picks them up\n  document.documentElement.style.setProperty('--accent',  _cfg.accent);\n  document.documentElement.style.setProperty('--accent2', _cfg.accent2);\n\n  [\n    ['brand-title',        _cfg.title],\n    ['general-card-title', _cfg.generalTitle],\n    ['sell-power-label',   _cfg.sellPowerLabel],\n    ['sell-enable-label',  _cfg.sellLabel],\n    ['grid-charge-label',  _cfg.gridChargeLabel],\n  ].forEach(([id, text]) => document.getElementById(id).textContent = text);\n\n  ['sell_power', 'peak_shaving_power'].forEach(id => document.getElementById(id).step = _cfg.powerStep);\n\n  // Populate #mode selector options (visible for Solis, hidden \"Energy Pattern\" for Deye)\n  const modeOpts = _cfg.energyPatternOptions || _cfg.modeOptions || [];\n  document.querySelector('#mode .inv-sel-opts').innerHTML = modeOpts\n    .map((o, i) => `<div class=\"inv-sel-opt${i===0?' sel':''}\" onclick=\"selPick(this, event)\">${o}</div>`)\n    .join('');\n\n  // Show brand-specific sections\n  if (info.auto_managed) document.getElementById('auto-switch-wrap').style.display = '';\n  if (_brand === 'solis') {\n    _buildSolisTou();\n    document.getElementById('solis-mode-field').style.display    = '';\n    document.getElementById('reserve-row').style.display         = '';\n    document.getElementById('tou-solis-discharge').style.display = '';\n    document.getElementById('tou-solis-charge').style.display    = '';\n  } else {\n    document.getElementById('deye-mode-field').style.display = '';\n    document.getElementById('tou-deye').style.display         = '';\n  }\n}\n\n/* ── Custom select ────────────────────────────────────────────────────────── */\n/* An option's submitted value is data-val where present, so a row can carry a\n   plain-language name and an explanation without changing what the firmware\n   is sent. Options built without data-val keep behaving as before. */\nconst _optVal = o => o.dataset.val ?? o.textContent.trim();\n\nfunction selSet(id, val) {\n  const sel = document.getElementById(id);\n  const opt = [...sel.querySelectorAll('.inv-sel-opt')].find(o => _optVal(o) === val);\n  if (!opt) return;\n  sel.dataset.value = val;\n  sel.querySelector('.inv-sel-val').textContent =\n    opt.querySelector('.opt-name')?.textContent ?? val;\n  sel.querySelectorAll('.inv-sel-opt').forEach(o => o.classList.toggle('sel', o === opt));\n  const hint = document.getElementById(sel.dataset.hint || '');\n  if (hint) hint.textContent = opt.dataset.hint || '';\n}\nfunction selToggle(el) {\n  const isOpen = el.classList.contains('open');\n  document.querySelectorAll('.inv-sel.open').forEach(s => s.classList.remove('open'));\n  if (!isOpen) el.classList.add('open');\n}\nfunction selPick(opt, e) {\n  selSet(opt.closest('.inv-sel').id, _optVal(opt));\n  opt.closest('.inv-sel').classList.remove('open');\n  e.stopPropagation();\n}\ndocument.addEventListener('click', e => {\n  if (!e.target.closest('.inv-sel')) document.querySelectorAll('.inv-sel.open').forEach(s => s.classList.remove('open'));\n});\n\n/* ── Drum scroll-wheel picker ─────────────────────────────────────────────── */\nconst ITEM_H = 44;\nconst CTR    = 2 * ITEM_H;\n\nclass Drum {\n  constructor(el, count, fmt) {\n    this.count = count;\n    this._maxY = CTR;\n    this._minY = CTR - (count - 1) * ITEM_H;\n    this._y    = CTR;\n    const items = document.createElement('div');\n    items.className = 'tp-items';\n    for (let i = 0; i < count; i++) {\n      const d = document.createElement('div');\n      d.className = 'tp-item';\n      d.textContent = fmt(i);\n      items.appendChild(d);\n    }\n    el.appendChild(items);\n    this._items = items;\n    const hl = document.createElement('div');\n    hl.className = 'tp-hl';\n    el.appendChild(hl);\n    this._bind(el);\n  }\n  get value() { return Math.max(0, Math.min(this.count - 1, Math.round((CTR - this._y) / ITEM_H))); }\n  set value(i) { this._moveTo(CTR - i * ITEM_H, false); }\n  _moveTo(y, anim) {\n    y = Math.max(this._minY, Math.min(this._maxY, y));\n    this._y = y;\n    this._items.style.transition = anim ? 'transform .22s cubic-bezier(.25,.46,.45,.94)' : 'none';\n    this._items.style.transform  = `translateY(${y}px)`;\n  }\n  _fling(y, vel) {\n    const idx = Math.round((CTR - (y + vel * 0.1)) / ITEM_H);\n    this._moveTo(CTR - Math.max(0, Math.min(this.count - 1, idx)) * ITEM_H, true);\n  }\n  _bind(el) {\n    let sy = null, y0, ly, lt, vel;\n    const start = cy => { this._items.style.transition = 'none'; sy = cy; y0 = this._y; ly = cy; lt = Date.now(); vel = 0; };\n    const move  = cy => {\n      if (sy === null) return;\n      const now = Date.now();\n      vel = (cy - ly) / Math.max(1, now - lt) * 1000;\n      ly = cy; lt = now;\n      let y = y0 + (cy - sy);\n      if (y > this._maxY) y = this._maxY + (y - this._maxY) * 0.25;\n      if (y < this._minY) y = this._minY - (this._minY - y) * 0.25;\n      this._y = y;\n      this._items.style.transform = `translateY(${y}px)`;\n    };\n    const end = () => { if (sy !== null) { this._fling(this._y, vel); sy = null; } };\n    el.addEventListener('touchstart', e => { start(e.touches[0].clientY); e.preventDefault(); }, { passive: false });\n    el.addEventListener('touchmove',  e => { move(e.touches[0].clientY);  e.preventDefault(); }, { passive: false });\n    el.addEventListener('touchend',   end);\n    el.addEventListener('mousedown',  e => start(e.clientY));\n    window.addEventListener('mousemove', e => { if (sy !== null) move(e.clientY); });\n    window.addEventListener('mouseup',   () => { if (sy !== null) end(); });\n    el.addEventListener('wheel', e => {\n      e.preventDefault();\n      const next = Math.max(0, Math.min(this.count - 1, this.value + (e.deltaY > 0 ? 1 : -1)));\n      this._moveTo(CTR - next * ITEM_H, true);\n    }, { passive: false });\n  }\n}\n\nlet _tpId = null, _drums = null;\nfunction _initDrums() {\n  if (_drums) return;\n  const pad = i => String(i).padStart(2, '0');\n  _drums = { h: new Drum(document.getElementById('tp-hour'), 24, pad), m: new Drum(document.getElementById('tp-min'), 60, pad) };\n}\nfunction openTimePicker(id) {\n  _initDrums();\n  _tpId = id;\n  const [h, m] = (document.getElementById(id).dataset.value || '00:00').split(':').map(Number);\n  _drums.h.value = h; _drums.m.value = m;\n  document.getElementById('tp-modal').style.display = 'flex';\n}\nfunction confirmTimePicker() {\n  const val = String(_drums.h.value).padStart(2,'0') + ':' + String(_drums.m.value).padStart(2,'0');\n  const btn = document.getElementById(_tpId);\n  btn.textContent = val; btn.dataset.value = val;\n  // Deye End column propagates to next slot's Start button via data-updates\n  if (btn.dataset.updates) {\n    const t = document.getElementById(btn.dataset.updates);\n    if (t) { t.textContent = val; t.dataset.value = val; }\n  }\n  document.getElementById('tp-modal').style.display = 'none';\n}\nfunction cancelTimePicker() { document.getElementById('tp-modal').style.display = 'none'; }\n\n/* ── Helpers ──────────────────────────────────────────────────────────────── */\nfunction flash(id, text, type) {\n  const el = document.getElementById(id);\n  if (!el) return;\n  el.textContent = text;\n  el.className = 'msg ' + type;\n  if (text) setTimeout(() => { if (el.textContent === text) el.textContent = ''; }, 4000);\n}\n\nfunction _roundW(val) {\n  const s = _cfg.powerStep;\n  return Math.round((parseInt(val) || 0) / s) * s;\n}\n\nasync function _post(path, body) {\n  const r = await fetch(BASE + path, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body) });\n  return r.json();\n}\n\nasync function saveWithFlash(path, body, msgId) {\n  try {\n    const data = await _post(path, body);\n    if (data.ok) { flash(msgId, '✓ Saved', 'ok'); return true; }\n    flash(msgId, '✗ ' + data.error, 'err');\n  } catch (e) { flash(msgId, '✗ ' + e.message, 'err'); }\n  return false;\n}\n\n/* ── Load settings ────────────────────────────────────────────────────────── */\nasync function loadSettings() {\n  try {\n    const res = await fetch(BASE + '/api/settings');\n    if (!res.ok) throw new Error('HTTP ' + res.status);\n    const d = await res.json();\n    fillGeneral(_brand === 'deye' ? d.general : d.storage);\n    fillBattery(d.battery);\n    if (_brand === 'deye') {\n      fillTou(d.tou.slots);\n    } else if (d.tou) {\n      fillSlots('discharge', d.tou.discharge_slots);\n      fillSlots('charge',    d.tou.charge_slots);\n    }\n    document.getElementById('updated').textContent = 'Updated ' + new Date().toLocaleTimeString();\n  } catch (e) {\n    document.getElementById('updated').textContent = '⚠ ' + e.message;\n  }\n}\n\n/* ── General / Storage ────────────────────────────────────────────────────── */\nfunction setSellLock(on)        { document.getElementById('sell_power').disabled         = !on; }\nfunction setPeakShavingLock(on) { document.getElementById('peak_shaving_power').disabled  = !on; }\nfunction setReserveLock(on)     { document.getElementById('battery_reserve_pct').disabled = !on; }\n\nfunction fillGeneral(g) {\n  const f = _cfg.gf;\n  selSet('mode', g[f.mode]);\n  if (f.limit_control) selSet('zero_export', g[f.limit_control] || 'Selling First');\n  document.getElementById('grid_charge').checked      = g[f.grid_charge];\n  document.getElementById('sell_enable').checked      = g[f.sell_enable];\n  document.getElementById('sell_power').value         = g[f.sell_power];\n  document.getElementById('peak_shaving').checked     = g[f.peak_shaving];\n  document.getElementById('peak_shaving_power').value = g[f.peak_power];\n  setSellLock(g[f.sell_enable]);\n  setPeakShavingLock(g[f.peak_shaving]);\n  if (_brand === 'solis') {\n    document.getElementById('battery_reserve_on').checked = g[f.reserve];\n    document.getElementById('battery_reserve_pct').value  = g[f.reserve_pct];\n    setReserveLock(g[f.reserve]);\n  }\n}\n\nasync function saveGeneral() {\n  const f    = _cfg.gf;\n  const body = {\n    [f.mode]:         document.getElementById('mode').dataset.value,\n    [f.grid_charge]:  document.getElementById('grid_charge').checked,\n    [f.sell_enable]:  document.getElementById('sell_enable').checked,\n    [f.sell_power]:   _roundW(document.getElementById('sell_power').value),\n    [f.peak_shaving]: document.getElementById('peak_shaving').checked,\n    [f.peak_power]:   _roundW(document.getElementById('peak_shaving_power').value),\n  };\n  if (_brand === 'deye') {\n    body[f.limit_control] = document.getElementById('zero_export').dataset.value;\n  }\n  if (_brand === 'solis') {\n    body[f.reserve]     = document.getElementById('battery_reserve_on').checked;\n    body[f.reserve_pct] = parseInt(document.getElementById('battery_reserve_pct').value) || 0;\n  }\n  if (await saveWithFlash(_cfg.generalEndpoint, body, 'general-msg')) loadSettings();\n}\n\n/* ── Battery ──────────────────────────────────────────────────────────────── */\nfunction fillBattery(b) {\n  if (!b) return;\n  const f = _cfg.bf;\n  document.getElementById('bat1_charge').value    = b[f.bat1_charge];\n  document.getElementById('bat1_discharge').value = b[f.bat1_discharge];\n  document.getElementById('bat2_charge').value    = b[f.bat2_charge];\n  document.getElementById('bat2_discharge').value = b[f.bat2_discharge];\n}\n\nasync function saveBattery() {\n  const f    = _cfg.bf;\n  const body = {\n    [f.bat1_charge]:    parseFloat(document.getElementById('bat1_charge').value)    || 0,\n    [f.bat1_discharge]: parseFloat(document.getElementById('bat1_discharge').value) || 0,\n    [f.bat2_charge]:    parseFloat(document.getElementById('bat2_charge').value)    || 0,\n    [f.bat2_discharge]: parseFloat(document.getElementById('bat2_discharge').value) || 0,\n  };\n  if (await saveWithFlash('/api/settings/battery', body, 'battery-msg')) loadSettings();\n}\n\n/* ── Deye TOU ─────────────────────────────────────────────────────────────── */\nlet _deyeSnap = null;\n\nfunction fillTou(slots) {\n  _deyeSnap = slots.map(s => ({...s}));\n  const tbody = document.getElementById('tou-body');\n  tbody.innerHTML = '';\n  slots.forEach((s, idx) => {\n    const nextSlot = (s.slot % 6) + 1;\n    const endTime  = slots[(idx + 1) % 6].time;\n    const tr = document.createElement('tr');\n    tr.innerHTML = `\n      <td class=\"num\">${s.slot}</td>\n      <td class=\"col-cb\"><input type=\"checkbox\" id=\"tou-grid-${s.slot}\" ${s.grid_charge?'checked':''}></td>\n      <td class=\"col-cb\"><input type=\"checkbox\" id=\"tou-gen-${s.slot}\"  ${s.gen_charge ?'checked':''}></td>\n      <td class=\"col-cb\"><input type=\"checkbox\" id=\"tou-sell-${s.slot}\" ${s.sell       ?'checked':''}></td>\n      <td class=\"col-time\">\n        <button class=\"time-btn\" id=\"tou-time-${s.slot}\" data-value=\"${s.time}\"\n          onclick=\"openTimePicker('tou-time-${s.slot}')\">${s.time}</button>\n      </td>\n      <td class=\"col-time\">\n        <button class=\"time-btn\" id=\"tou-end-${s.slot}\" data-value=\"${endTime}\"\n          data-updates=\"tou-time-${nextSlot}\"\n          onclick=\"openTimePicker('tou-end-${s.slot}')\">${endTime}</button>\n      </td>\n      <td class=\"col-n\"><input type=\"number\" id=\"tou-pwr-${s.slot}\" value=\"${s.power_w}\" min=\"0\" step=\"10\"></td>\n      <td class=\"col-n\"><input type=\"number\" id=\"tou-soc-${s.slot}\" value=\"${s.soc_pct}\" min=\"0\" max=\"100\"></td>`;\n    tbody.appendChild(tr);\n  });\n}\n\nfunction _deyeSlotChanged(slot) {\n  const prev = _deyeSnap?.[slot - 1];\n  if (!prev) return true;\n  return document.getElementById(`tou-time-${slot}`).dataset.value !== prev.time\n      || (parseInt(document.getElementById(`tou-pwr-${slot}`).value) || 0) !== prev.power_w\n      || (parseInt(document.getElementById(`tou-soc-${slot}`).value) || 0) !== prev.soc_pct\n      || document.getElementById(`tou-grid-${slot}`).checked !== prev.grid_charge\n      || document.getElementById(`tou-gen-${slot}`).checked  !== prev.gen_charge\n      || document.getElementById(`tou-sell-${slot}`).checked !== prev.sell;\n}\n\nasync function saveTou() {\n  const btn = document.querySelector('[onclick=\"saveTou()\"]');\n  btn.disabled = true;\n  const toSave = [1,2,3,4,5,6].filter(_deyeSlotChanged).map(slot => ({\n    slot,\n    body: {\n      time:        document.getElementById(`tou-time-${slot}`).dataset.value,\n      power_w:     parseInt(document.getElementById(`tou-pwr-${slot}`).value)  || 0,\n      soc_pct:     parseInt(document.getElementById(`tou-soc-${slot}`).value)  || 0,\n      grid_charge: document.getElementById(`tou-grid-${slot}`).checked,\n      gen_charge:  document.getElementById(`tou-gen-${slot}`).checked,\n      sell:        document.getElementById(`tou-sell-${slot}`).checked,\n    }\n  }));\n  if (toSave.length === 0) { btn.disabled = false; flash('tou-msg', '✓ No changes', 'ok'); return; }\n  const results = await Promise.all(toSave.map(({ slot, body }) =>\n    _post(`/api/settings/tou/${slot}`, body).catch(e => ({ ok:false, error:e.message }))\n  ));\n  btn.disabled = false;\n  const failed = results.filter(r => !r.ok);\n  if (failed.length === 0) { flash('tou-msg', `✓ Saved (${toSave.length} slot${toSave.length>1?'s':''})`, 'ok'); loadSettings(); }\n  else flash('tou-msg', `✗ ${failed.length} slot(s) failed: ${failed[0].error}`, 'err');\n}\n\n/* ── Solis TOU ────────────────────────────────────────────────────────────── */\nconst _solisSnap = { charge: null, discharge: null };\n\nfunction fillSlots(type, slots) {\n  const tbody = document.getElementById(type + '-body');\n  tbody.innerHTML = '';\n  slots.forEach(s => {\n    const tr = document.createElement('tr');\n    if (s.enabled) tr.className = 'on';\n    tr.id = `row-${type}-${s.slot}`;\n    tr.innerHTML = `\n      <td class=\"num\">${s.slot}</td>\n      <td><input type=\"checkbox\" id=\"${type}-en-${s.slot}\" ${s.enabled?'checked':''} onchange=\"syncRow('${type}',${s.slot})\"></td>\n      <td class=\"col-time\">\n        <button class=\"time-btn\" id=\"${type}-start-${s.slot}\" data-value=\"${s.start}\"\n          onclick=\"openTimePicker('${type}-start-${s.slot}')\">${s.start}</button>\n      </td>\n      <td class=\"col-time\">\n        <button class=\"time-btn\" id=\"${type}-end-${s.slot}\" data-value=\"${s.end}\"\n          onclick=\"openTimePicker('${type}-end-${s.slot}')\">${s.end}</button>\n      </td>\n      <td class=\"col-n\"><input type=\"number\" id=\"${type}-cur-${s.slot}\" value=\"${s.current_a}\" min=\"0\" step=\"0.1\"></td>\n      <td class=\"col-n\"><input type=\"number\" id=\"${type}-soc-${s.slot}\" value=\"${s.soc_pct}\"   min=\"0\" max=\"100\"></td>`;\n    tbody.appendChild(tr);\n    lockRow(type, s.slot, s.enabled);\n  });\n  _solisSnap[type] = slots.map(s => ({...s}));\n}\n\nfunction lockRow(type, slot, on) {\n  [`${type}-start-${slot}`, `${type}-end-${slot}`, `${type}-cur-${slot}`, `${type}-soc-${slot}`]\n    .forEach(id => { const el = document.getElementById(id); if (el) el.disabled = !on; });\n}\nfunction syncRow(type, slot) {\n  const on = document.getElementById(`${type}-en-${slot}`).checked;\n  document.getElementById(`row-${type}-${slot}`).className = on ? 'on' : '';\n  lockRow(type, slot, on);\n}\n\nfunction _solisSlotChanged(type, slot, body) {\n  const prev = _solisSnap[type]?.[slot - 1];\n  if (!prev) return true;\n  return body.enabled !== prev.enabled || body.start !== prev.start || body.end !== prev.end\n      || Math.abs(body.current_a - prev.current_a) > 0.001 || body.soc_pct !== prev.soc_pct;\n}\n\nasync function saveAllSlots(type) {\n  const btn = document.querySelector(`[onclick=\"saveAllSlots('${type}')\"]`);\n  btn.disabled = true;\n  const toSave = [1,2,3,4,5,6].map(slot => {\n    const body = {\n      enabled:   document.getElementById(`${type}-en-${slot}`).checked,\n      start:     document.getElementById(`${type}-start-${slot}`).dataset.value,\n      end:       document.getElementById(`${type}-end-${slot}`).dataset.value,\n      current_a: parseFloat(document.getElementById(`${type}-cur-${slot}`).value) || 0,\n      soc_pct:   parseInt(document.getElementById(`${type}-soc-${slot}`).value)   || 0,\n    };\n    return _solisSlotChanged(type, slot, body) ? { slot, body } : null;\n  }).filter(Boolean);\n  if (toSave.length === 0) { btn.disabled = false; flash(`${type}-msg`, '✓ No changes', 'ok'); return; }\n  const results = await Promise.all(toSave.map(({ slot, body }) =>\n    _post(`/api/settings/tou/${type}/${slot}`, body).catch(e => ({ ok:false, error:e.message }))\n  ));\n  btn.disabled = false;\n  const failed = results.filter(r => !r.ok);\n  if (failed.length === 0) { flash(`${type}-msg`, `✓ Saved (${toSave.length} slot${toSave.length>1?'s':''})`, 'ok'); loadSettings(); }\n  else flash(`${type}-msg`, `✗ ${failed.length} slot(s) failed`, 'err');\n}\n\n/* ── Solis TOU card builder ───────────────────────────────────────────────── */\nfunction _buildSolisTou() {\n  if (document.getElementById('tou-solis-discharge')) return;\n  const wrap = document.querySelector('.inv-main');\n  ['discharge', 'charge'].forEach(type => {\n    const title = type === 'discharge' ? 'TOU — Discharge Slots' : 'TOU — Charge Slots';\n    const div   = document.createElement('div');\n    div.id        = `tou-solis-${type}`;\n    div.className = 'card';\n    div.style.display = 'none';\n    div.innerHTML = `\n      <h2>${title}</h2>\n      <div class=\"tou-wrap\"><table>\n        <thead><tr>\n          <th>#</th><th>En</th>\n          <th class=\"col-time\">Start</th><th class=\"col-time\">End</th>\n          <th class=\"col-n\">Current A</th><th class=\"col-n\">SOC %</th>\n        </tr></thead>\n        <tbody id=\"${type}-body\"></tbody>\n      </table></div>\n      <div class=\"actions\">\n        <button class=\"primary\" onclick=\"saveAllSlots('${type}')\">Save</button>\n        <span class=\"msg\" id=\"${type}-msg\"></span>\n      </div>`;\n    wrap.appendChild(div);\n  });\n}\n\n/* ── Auto-managed (any brand whose /api/info reports auto_managed) ─────────── */\nlet _autoTimer = null;\n\nasync function loadAutoManaged() {\n  try {\n    const d = await fetch(BASE + '/api/auto-managed').then(r => r.json());\n    applyAutoMode(d.enabled);\n  } catch (_) {}\n}\n\nasync function setAutoManaged(on) {\n  try {\n    const r = await fetch(BASE + '/api/auto-managed', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({enabled:on}) });\n    if (!r.ok) throw new Error((await r.json().catch(() => ({}))).error || 'HTTP ' + r.status);\n    applyAutoMode(on);\n  } catch (e) {\n    flash('general-msg', '✗ ' + e.message, 'err');\n    await loadAutoManaged();   // show what the server actually holds\n  }\n}\n\nfunction applyAutoMode(on) {\n  document.getElementById('auto-managed').checked = on;\n  document.getElementById('auto-overlay').style.display = on ? 'block' : 'none';\n  document.getElementById('auto-banner').classList.toggle('visible', on);\n  clearInterval(_autoTimer);\n  if (on) _autoTimer = setInterval(loadSettings, 30000);\n}\n\n/* ── Init ─────────────────────────────────────────────────────────────────── */\nasync function init() {\n  try {\n    const info = await fetch(BASE + '/api/info').then(r => r.json());\n    applyBrand(info);\n    if (info.auto_managed) await loadAutoManaged();\n    await loadSettings();\n  } catch (e) {\n    document.getElementById('updated').textContent = '⚠ ' + e.message;\n  }\n}\n\nrequestAnimationFrame(init);\n</script>\n",
